option(
  'examples',
  type: 'boolean',
  value: false,
  description: 'Build Runara examples'
)

option(
  'backends',
  type: 'combo',
  choices: ['opengl', 'vulkan', 'all'],
  value: 'opengl',
  description: 'GPU backends to compile'
)

option('x11-examples', type: 'boolean', value: true,
       description: 'Build X11 examples')

option('glfw-examples', type: 'boolean', value: true,
       description: 'Build GLFW examples')

option('sdl-examples', type: 'boolean', value: true,
       description: 'Build SDL2 examples')
